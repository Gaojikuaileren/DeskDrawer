{
  "name": "deskdrawer-site",
  "private": true,
  "version": "1.2.5",
  "description": "Static site generator for deskdrawer.pages.dev — no dependencies, output committed to ../docs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node check.mjs",
    "all": "node build.mjs && node check.mjs",
    "icons": "python tools/gen-icons.py",
    "serve": "python -m http.server 8788 --directory ../docs --bind 127.0.0.1"
  },
  "engines": { "node": ">=18" }
}
